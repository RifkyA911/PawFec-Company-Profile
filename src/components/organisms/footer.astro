---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 px-4 sm:px-6 lg:px-8 py-16">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
    <!-- Brand -->
    <div class="lg:col-span-2 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="relative">
          <svg class="w-10 h-10 text-orange-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3-8c0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3 3 1.34 3 3zm-5.5-2c.83 0 1.5.67 1.5 1.5S10.33 13 9.5 13 8 12.33 8 11.5 8.67 10 9.5 10zm7 0c.83 0 1.5.67 1.5 1.5S17.33 13 16.5 13 15 12.33 15 11.5 15.67 10 16.5 10z"/></svg>
          <div class="absolute -top-1 -right-1 w-3 h-3 bg-amber-400 rounded-full" />
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold font-fredoka text-gray-800">Pawfec</span>
          <span class="text-sm font-semibold font-balsamiq text-orange-500">Care</span>
        </div>
      </div>

      <p class="text-gray-600 font-fredoka leading-relaxed">
        At Pawfec Care, feline love meets expert care. We deliver trusted, science-backed guidance to help every cat thrive. Your cat's happiness is our priority.
      </p>

      <div class="flex gap-4">
        <a href="#" class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 hover:bg-orange-200 transition-colors">
          🐱
        </a>
        <a href="#" class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 hover:bg-orange-200 transition-colors">
          📘
        </a>
        <a href="#" class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 hover:bg-orange-200 transition-colors">
          📸
        </a>
        <a href="#" class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 hover:bg-orange-200 transition-colors">
          🎵
        </a>
      </div>
    </div>

    <!-- Services -->
    <div>
      <h4 class="font-fredoka font-semibold text-orange-500 mb-4 text-lg">Services</h4>
      <ul class="space-y-3 text-gray-600 font-fredoka">
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Professional Grooming</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Health Check</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Pet Sitting</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Nutrition Planning</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Behavior Training</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Dental Care</li>
      </ul>
    </div>

    <!-- Shop -->
    <div>
      <h4 class="font-fredoka font-semibold text-orange-500 mb-4 text-lg">Our Shop</h4>
      <ul class="space-y-3 text-gray-600 font-fredoka">
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Premium Cat Food</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Organic Treats</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Clumping Litter</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Deshedding Tools</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Cat Toys</li>
        <li class="hover:text-orange-500 transition-colors cursor-pointer">Comfort Beds</li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h4 class="font-fredoka font-semibold text-orange-500 mb-4 text-lg">Contact Info</h4>
      <ul class="space-y-3 text-gray-600 font-fredoka">
        <li class="flex items-start gap-2">
          <span class="font-semibold">Phone:</span>
          <span>(123) 456-7890</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-semibold">Email:</span>
          <span>support@pawfecare.com</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-semibold">Address:</span>
          <span>123 Cat Street, Meowville, CA 90210</span>
        </li>
      </ul>

      <!-- Working Hours -->
      <div class="mt-6 bg-orange-50 rounded-xl p-4">
        <h5 class="font-semibold font-fredoka text-orange-500 mb-2">Working Hours</h5>
        <div class="space-y-1 text-sm text-gray-600 font-balsamiq">
          <div class="flex justify-between">
            <span>Mon - Fri:</span>
            <span class="font-semibold">7 AM - 6 PM</span>
          </div>
          <div class="flex justify-between">
            <span>Saturday:</span>
            <span class="font-semibold">9 AM - 4 PM</span>
          </div>
          <div class="flex justify-between">
            <span>Sunday:</span>
            <span class="font-semibold">Closed</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright & Portfolio Showcase -->
  <div class="mt-12 pt-8 border-t border-gray-200">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-center md:text-left">
        <p class="text-gray-600 font-fredoka">
          © Copyright {currentYear}, All Rights Reserved by 
          <a href="https://github.com/RifkyA911" target="_blank" rel="noopener noreferrer" class="text-orange-500 hover:text-orange-600 font-semibold transition-colors">
            @RifkyA911
          </a>
        </p>
      </div>
      
      <div class="flex items-center gap-4">
        <span class="text-gray-500 font-fredoka text-sm">Portfolio Showcase</span>
        <a href="https://github.com/RifkyA911" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-gradient-to-r from-orange-500 to-amber-500 text-white px-4 py-2 rounded-full text-sm font-semibold font-fredoka hover:shadow-lg transition-all hover:scale-105">
          <span>View on GitHub</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</footer>
