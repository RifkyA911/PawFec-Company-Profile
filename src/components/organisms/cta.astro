---
---

<section id="contact" class="relative py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white via-orange-50 to-white overflow-hidden">

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-orange-100 text-orange-600 px-4 py-2 rounded-full mb-6">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/></svg>
        <span class="font-semibold font-fredoka text-sm">Get In Touch</span>
      </div>
      
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-balsamiq text-gray-800 mb-4">
        Hi, How can we help you?
      </h2>
      
      <p class="text-xl text-gray-600 font-fredoka max-w-3xl mx-auto">
        Providing Expert Advice, Loving Care, and Essential Tips for a Happy and Healthy Cat. Reach out to us today!
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Contact Form -->
      <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12">
        <h3 class="text-2xl font-bold font-dynapuff text-gray-800 mb-6">Send us a Message</h3>
        
        <form class="space-y-6">
          <div>
            <label class="block text-sm font-semibold font-fredoka text-gray-700 mb-2">Your Name</label>
            <input
              type="text"
              placeholder="John Doe"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-400 focus:ring-2 focus:ring-orange-200 outline-none transition-all font-balsamiq"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold font-fredoka text-gray-700 mb-2">Email Address</label>
            <input
              type="email"
              placeholder="john@example.com"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-400 focus:ring-2 focus:ring-orange-200 outline-none transition-all font-balsamiq"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold font-fredoka text-gray-700 mb-2">Phone Number</label>
            <input
              type="tel"
              placeholder="+1 (123) 456-7890"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-400 focus:ring-2 focus:ring-orange-200 outline-none transition-all font-balsamiq"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold font-fredoka text-gray-700 mb-2">Message</label>
            <textarea
              placeholder="Tell us about your cat and how we can help..."
              rows="4"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-400 focus:ring-2 focus:ring-orange-200 outline-none transition-all font-balsamiq resize-none"
            />
          </div>
          
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="bg-gradient-to-r from-orange-500 to-amber-500 rounded-3xl p-8 md:p-12 text-white">
          <h3 class="text-2xl font-bold font-fredoka mb-6">Contact Information</h3>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold font-fredoka mb-1">Phone</h4>
                <p class="text-white/90 font-balsamiq">+1 (123) 456-7890</p>
                <p class="text-white/70 text-sm font-balsamiq">Available 24/7 for emergencies</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <h4 class="font-semibold font-fredoka mb-1">Email</h4>
                <p class="text-white/90 font-balsamiq">support@pawfecare.com</p>
                <p class="text-white/70 text-sm font-balsamiq">We reply within 24 hours</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4 class="font-semibold font-fredoka mb-1">Address</h4>
                <p class="text-white/90 font-balsamiq">123 Cat Street, Meowville</p>
                <p class="text-white/70 text-sm font-balsamiq">CA 90210, United States</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <h4 class="font-semibold font-fredoka mb-1">Working Hours</h4>
                <p class="text-white/90 font-balsamiq">Mon - Fri: 7 AM - 6 PM</p>
                <p class="text-white/90 font-balsamiq">Saturday: 9 AM - 4 PM</p>
                <p class="text-white/70 text-sm font-balsamiq">Sunday: Closed</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Contact Buttons -->
        <div class="grid grid-cols-2 gap-4">
          <a
            href="tel:+1234567890"
            class="flex items-center justify-center gap-2 bg-white rounded-2xl p-4 shadow-md hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-orange-200 hover:border-orange-400"
          >
            <span class="text-lg">📞</span>
            <span class="font-semibold font-fredoka text-gray-800">Call Now</span>
          </a>
          <a
            href="mailto:support@pawfecare.com"
            class="flex items-center justify-center gap-2 bg-white rounded-2xl p-4 shadow-md hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-orange-200 hover:border-orange-400"
          >
            <span class="text-lg">✉️</span>
            <span class="font-semibold font-fredoka text-gray-800">Email Us</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #contact .bg-white.rounded-3xl {
    opacity: 0;
    transform: translateX(-50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  #contact .bg-white.rounded-3xl.visible {
    opacity: 1;
    transform: translateX(0);
  }

  #contact .space-y-8 > div:first-of-type {
    opacity: 0;
    transform: translateX(50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  #contact .space-y-8 > div:first-of-type.visible {
    opacity: 1;
    transform: translateX(0);
  }

  #contact .grid-cols-2 {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  #contact .grid-cols-2.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  window.addEventListener("load", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: "0px 0px -100px 0px"
    });

    const formCard = document.querySelector("#contact .bg-white.rounded-3xl");
    const infoCard = document.querySelector("#contact .space-y-8 > div:first-of-type");
    const quickButtons = document.querySelector("#contact .grid-cols-2");

    if (formCard) observer.observe(formCard);
    if (infoCard) setTimeout(() => observer.observe(infoCard), 200);
    if (quickButtons) setTimeout(() => observer.observe(quickButtons), 400);
  });
</script>
