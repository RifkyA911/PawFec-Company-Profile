---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
---

<main>
  <section
    id="hero"
    class="mt-12 min-h-[620px] flex flex-col items-center justify-center align-middle"
  >
    <h1 class="text-6xl font-bold font-balsamiq contents">
      <span>Caring for cats with</span>
      <span class="mt-4 text-orange-500 text-7xl font-extrabold"
        >Love and ExPURRtise!</span
      >
    </h1>
    <section id="links">
      <a href="https://astro.build"
        ><img
          src={"/images/cat-bg.png"}
          width="250"
          height="500"
          alt="Astro Homepage"
        /></a
      >
    </section>
  </section>
</main>
