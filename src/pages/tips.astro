---
import { Stethoscope } from "lucide-react";

const tips = [
  {
    description:
      "Choose high-quality, well-balanced cat food suited to their age and health needs.",
  },
  {
    description:
      "Schedule annual vet visits for vaccinations, health screenings, and preventive care.",
  },
  {
    description:
      "Regularly brush their coat to prevent matting, trim nails, and clean ears to maintain hygiene.",
  },
];
---

<section
  id="tips"
  class="px-8 py-12 min-h-[720px] flex flex-col gap-8 items-center justify-center align-middle"
>
  <div
    class="relative bg-amber-500 flex gap-4 w-[1280px] h-[480px] items-center justify-end align-middle rounded-4xl"
  >
    <div class="absolute bottom-0 left-0">
      <img
        src={`https://png.pngtree.com/png-clipart/20250814/original/pngtree-happy-veterinary-doctor-holding-fluffy-cat-in-white-office-png-image_21393757.png`}
        height="550"
        width="550"
      />
    </div>
    <div
      class="absolute flex justify-center items-center gap-4 bottom-4 p-4 left-[300px] rounded-4xl bg-white shadow-lg"
    >
      <Stethoscope className="text-gray-800" width={32} height={32} />
      <div class="border-l-4 border-gray-600 px-4">
        <h4 class="font-balsamiq font-medium text-gray-800 text-xl">
          Dr. John Doe
        </h4>
        <h5 class="font-balsamiq font-medium text-gray-500 text-sm">
          Head of Feline Haven
        </h5>
      </div>
    </div>
    <div class="flex flex-col align-middle justify-center p-8 w-1/2">
      <h2 class="text-4xl text-white font-bold contents font-fredoka">
        <span>Tips From Our Expert</span>
      </h2>
      <div class="mt-8 flex flex-col gap-8">
        {
          tips.map((tip) => (
            <div
              class="h-[80px] p-6 flex gap-4 justify-center items-center
             bg-white text-gray-700 hover:bg-amber-500 hover:text-white rounded-4xl transition"
            >
              <img
                src={`https://cdn-icons-png.flaticon.com/512/12/12638.png`}
                alt={tip.description}
                height="20"
                width="20"
              />

              <h5 class="font-fredoka text-lg">{tip.description}</h5>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="flex flex-col gap-4"></div>
</section>
