---
const services = [
  {
    image:
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRdkwC2aNfXCGZdPJg06qtZVWv5RYhJCETejw&s",
    title: "Grooming",
    description:
      "Full grooming for a happy, clean cat,bath, brush, nail trim, and more.",
  },
  {
    image:
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRdkwC2aNfXCGZdPJg06qtZVWv5RYhJCETejw&s",
    title: "Health Check",
    description:
      "Routine vet check-ups to keep your cat in top shape so they can lead healthy life.",
  },
  {
    image:
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRdkwC2aNfXCGZdPJg06qtZVWv5RYhJCETejw&s",
    title: "Pet Sitting",
    description:
      "Safe, cozy care while you're away, with plenty of love and play on daily routine basis.",
  },
  {
    image:
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRdkwC2aNfXCGZdPJg06qtZVWv5RYhJCETejw&s",
    title: "Nutrition",
    description:
      "Personalized diet plans for a healthy, happy cat so they can lead a very healthy life.",
  },
];
---

<section
  id="services"
  class="bg-slate-200 px-8 py-12 xmt-12 flex flex-col gap-8 items-center justify-center align-middle"
>
  <div
    class="flex flex-col gap-4 w-full items-center justify-center align-middle"
  >
    <h2 class="text-5xl font-bold contents font-fredoka">
      <span>Service We Provide</span>
    </h2>
    <h3 class="text-2xl text-gray-600 font-fredoka max-w-[640px] text-center">
      Your Ultimate Destination for Expert Care, Training, and Wellness to Keep
      Your Furry Friends Happy and Healthy!
    </h3>
  </div>
  <div class="mt-8 grid grid-cols-4 gap-8">
    {
      services.map((service) => (
        <div
          class="service-card w-[320px] h-[440px] p-6 flex flex-col gap-4 justify-center items-center
             bg-white text-gray-700 hover:bg-amber-500 hover:text-white rounded-4xl text-center transition"
        >
          <img src={service.image} alt={service.title} height="50" width="50" />

          <h4 class="text-3xl font-medium font-dynapuff">{service.title}</h4>

          <h5 class="font-fredoka text-xl">{service.description}</h5>
        </div>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("load", () => {
    const cards = document.querySelectorAll("#services .service-card");
    const images = document.querySelectorAll("#services img");

    gsap.from(cards, {
      opacity: 0,
      y: 80,
      stagger: 0.2,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "#services",
        start: "top 85%",
        toggleActions: "play none none none",
      },
    });

    gsap.from(images, {
      scale: 0.7,
      opacity: 0,
      stagger: 0.15,
      scrollTrigger: {
        trigger: "#services",
        start: "top 85%",
        toggleActions: "play none none none",
      },
    });

    ScrollTrigger.refresh(); // memastikan ScrollTrigger tahu posisi elemen
  });
</script>

