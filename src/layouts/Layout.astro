---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Pawfec Care - Premium cat care services including grooming, health checks, pet sitting, nutrition planning, and behavior training. Expert care for your feline friends." />
    <title>Pawfec Care - Premium Cat Care Services</title>
  </head>
  <body class="bg-white relative">
    <!-- Left Side Mesh Grid -->
    <div class="fixed left-0 top-0 bottom-0 w-32 lg:w-64 overflow-hidden pointer-events-none z-0 hidden lg:block">
      <svg class="absolute inset-0 w-full h-full" width="100%" height="100%">
        <defs>
          <pattern id="grid-left" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="gray" stroke-width="0.5" opacity="0.3"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-left)" />
      </svg>
      <!-- Single paw with falling animation -->
      <div class="absolute top-[10%] left-8 text-[120px] text-orange-300 opacity-7 animate-fall" style="animation-delay: 0s; transform: rotate(30deg);">🐾</div>
    </div>

    <!-- Right Side Mesh Grid -->
    <div class="fixed right-0 top-0 bottom-0 w-32 lg:w-64 overflow-hidden pointer-events-none z-0 hidden lg:block">
      <svg class="absolute inset-0 w-full h-full" width="100%" height="100%">
        <defs>
          <pattern id="grid-right" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="gray" stroke-width="0.5" opacity="0.3"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-right)" />
      </svg>
      <!-- Single paw with falling animation -->
      <div class="absolute top-[10%] right-8 text-[120px] text-amber-300 opacity-7 animate-fall" style="animation-delay: 0.5s; transform: rotate(-30deg);">🐾</div>
    </div>

    <div id="container" class="max-w-[1536px] mx-auto relative z-10">
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #f97316, #f59e0b);
    border-radius: 5px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #ea580c, #d97706);
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-30px);
    }
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  @keyframes fall {
    0% {
      transform: translate(0, 0) rotate(30deg);
      opacity: 0.07;
    }
    50% {
      transform: translate(-30px, 200px) rotate(15deg);
      opacity: 0.07;
    }
    100% {
      transform: translate(-60px, 400px) rotate(0deg);
      opacity: 0.07;
    }
  }

  .animate-fall {
    animation: fall 8s ease-in-out infinite;
  }
</style>
